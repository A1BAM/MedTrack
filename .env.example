# Neon Postgres connection string (Neon dashboard -> Connect -> connection string)
DATABASE_URL=postgres://user:password@ep-xxx-xxx.region.aws.neon.tech/neondb?sslmode=require

# Auth: the one password that unlocks the app, and a random secret used to
# sign the session cookie. Generate the secret with: openssl rand -hex 32
APP_PASSWORD=choose-a-long-password
SESSION_SECRET=64-hex-chars-from-openssl-rand-hex-32

# Shown in the UI (baked in at build time)
NEXT_PUBLIC_MED_NAME=My medication
NEXT_PUBLIC_TYPICAL_DOSE_MG=20
