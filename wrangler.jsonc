{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "medtrack",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-05-05",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
  // Secrets (DATABASE_URL, APP_PASSWORD, SESSION_SECRET) are NOT set here —
  // use `npx wrangler secret put <NAME>` or the Cloudflare dashboard, and
  // .dev.vars for local preview. See README.
}
